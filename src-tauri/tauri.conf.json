{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiwano",
  "version": "0.1.6",
  "identifier": "com.lightconsen.kiwano",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kiwano",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNkM5NTZGMUI3REI2MDcKUldRSHRuMGJiNVZzZXpzdnZzN0xaczY1cjZrVHhQbElkN0lSK0hnUmVmTHZDclE5eENUeURuQ1YK",
      "endpoints": [
        "https://github.com/lightconsen/kiwano/releases/latest/download/latest.json",
        "https://hub.kiwano.cc/releases/latest.json"
      ]
    }
  }
}